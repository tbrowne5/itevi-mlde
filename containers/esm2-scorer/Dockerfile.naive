# WEDNESDAY ARTIFACT. Deliberately wrong in ways you will measure.
# Keep this file in the repo forever; it is the before-picture.
#
# Three defects, in order of how much time they cost you:
#   1. COPY . . before pip install  -> any code edit reinstalls torch (~4 min)
#   2. weights downloaded after deps -> any dep change re-pulls 2.5 GB
#   3. single stage on -devel base   -> ships nvcc and headers to production
#
# Build it, time it, break the cache, time it again, then fix one defect at a
# time and re-time. Write all six numbers in learning-log.md.

FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3 python3-pip git curl

WORKDIR /app
COPY . .

RUN pip3 install --extra-index-url https://download.pytorch.org/whl/cu124 -r requirements.txt
RUN pip3 install -e .

ENV TORCH_HOME=/opt/torch
RUN python3 scripts/fetch_weights.py

CMD ["esm2-score", "--help"]
