# direnv: `direnv allow` once per checkout.
export PYTORCH_ENABLE_MPS_FALLBACK=1   # ESM-2 ops that lack an MPS kernel fall to CPU
export ITEVI_ROOT="$PWD"
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1
# Uncomment on the server once ECR exists (Week 2):
# export ECR_REGISTRY="<acct>.dkr.ecr.us-east-2.amazonaws.com"
# export AWS_REGION="us-east-2"
[ -d .venv-local ] && source .venv-local/bin/activate
